DISCORD_BOT_TOKEN=your_discord_bot_token_here
VOICE_CHANNEL_ID=123456789012345678
WEBHOOK_URL=https://your-backend.example.com/webhooks/discord-voice
WEBHOOK_SECRET=optional_shared_secret
JULGAR_CHANNEL_ID=123456789012345679

# Notion integration (optional) — /tasks, /create-task, /stop-timer
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id
NOTION_SHIFT_DATABASE_ID=your_notion_shift_database_id

# Google Calendar (opcional)
# 1. Crie um projeto no Google Cloud Console
# 2. Ative a Google Calendar API
# 3. Crie credenciais OAuth 2.0 (tipo: Web application)
# 4. Adicione a redirect URI: http://localhost:8080/oauth2callback
# 5. Copie o Client ID e Client Secret abaixo
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Canal de texto onde os comandos !agendar, !eventos, !cancelar funcionarao
# (opcional: se omitido, usa JULGAR_CHANNEL_ID)
CALENDAR_CHANNEL_ID=
# URI de redirecionamento OAuth (deve ser igual ao registrado no Google Cloud)
CALENDAR_REDIRECT_URI=http://localhost:8080/oauth2callback
# Porta local para o servidor de callback OAuth
CALENDAR_OAUTH_PORT=8080
# Fuso horario usado ao criar eventos
CALENDAR_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Spotify do casal (opcional) — !conectar, !agora, !top, !comparar, !desconectar
# ---------------------------------------------------------------------------
# 1. Crie um app em https://developer.spotify.com/dashboard (fica em Development Mode)
# 2. O dono do app precisa manter Spotify Premium ativo (exigencia desde fev/2026)
# 3. Em "User Management", cadastre as duas contas que vao usar (limite: 5 usuarios)
# 4. Em "Redirect URIs", registre exatamente o mesmo valor de SPOTIFY_REDIRECT_URI
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# URL publica HTTPS que o proxy encaminha para o bot. O path deve ser /spotify/callback
SPOTIFY_REDIRECT_URI=https://seu-dominio.com/spotify/callback
# Interface e porta em que o bot escuta o callback dentro do container
SPOTIFY_OAUTH_HOST=0.0.0.0
SPOTIFY_OAUTH_PORT=8888

# Servidor, canal privado e os dois IDs de usuario autorizados (separados por virgula)
SPOTIFY_GUILD_ID=
SPOTIFY_CHANNEL_ID=
SPOTIFY_USER_IDS=

# Banco SQLite — precisa apontar para dentro do volume persistente
SPOTIFY_DB_PATH=/data/spotify.db

# Chave Fernet que cifra os tokens no banco. Gere uma vez e nunca troque
# (trocar invalida os tokens ja salvos e exige !conectar de novo):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPOTIFY_ENCRYPTION_KEY=
